{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agt.local/contracts/agt_relocalization_study_v1.schema.json",
  "title": "AGT Relocalization Study v1",
  "type": "object",
  "required": ["schema_version", "asset_type", "study_id", "revision", "status", "source_ref", "annotation_ref", "block_set_ref", "query_set_ref", "query_accumulation_frames", "candidate_top_k", "algorithm", "reference_level", "job", "results", "content_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "asset_type": {"const": "agt.relocalization_study/v1"},
    "study_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["QUEUED", "RUNNING", "SUCCEEDED", "PARTIAL", "FAILED", "CANCELED", "STALE"]},
    "source_ref": {"$ref": "agt_relocalization_query_set_v1.schema.json#/$defs/sourceRef"},
    "annotation_ref": {"anyOf": [{"$ref": "agt_relocalization_query_set_v1.schema.json#/$defs/annotationRef"}, {"type": "null"}]},
    "block_set_ref": {"$ref": "agt_relocalization_query_set_v1.schema.json#/$defs/blockRef"},
    "annotation_ref": {"anyOf": [{"$ref": "agt_relocalization_query_set_v1.schema.json#/$defs/annotationRef"}, {"type": "null"}]},
    "query_set_ref": {"type": "object", "required": ["kind", "path", "content_sha256", "query_set_id", "revision"], "properties": {"kind": {"const": "filesystem"}, "path": {"type": "string", "minLength": 1, "pattern": "^(?!/).+"}, "content_sha256": {"$ref": "agt_relocalization_query_set_v1.schema.json#/$defs/digest"}, "query_set_id": {"type": "string"}, "revision": {"type": "integer", "minimum": 1}}},
    "query_accumulation_frames": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": [1, 3, 5]}},
    "candidate_top_k": {"type": "integer", "minimum": 1, "maximum": 5},
    "algorithm": {"type": "object", "required": ["name", "implementation", "native_algorithm_changes", "time_budget_s", "candidate_top_k", "query_accumulation_frames", "config_digest"], "properties": {"name": {"type": "string"}, "implementation": {"type": "string"}, "native_algorithm_changes": {"const": false}, "time_budget_s": {"type": "number", "exclusiveMinimum": 0}, "candidate_top_k": {"type": "integer", "minimum": 1, "maximum": 5}, "query_accumulation_frames": {"type": "array"}, "config_digest": {"$ref": "agt_relocalization_query_set_v1.schema.json#/$defs/digest"}}, "additionalProperties": true},
    "reference_level": {"enum": ["SAME_SESSION_REFERENCE", "INDEPENDENT_GROUND_TRUTH", "UNKNOWN"]},
    "job": {"type": "object", "required": ["cancel_requested", "completed", "total", "failed", "current_query"], "properties": {"cancel_requested": {"type": "boolean"}, "completed": {"type": "integer", "minimum": 0}, "total": {"type": "integer", "minimum": 0}, "failed": {"type": "integer", "minimum": 0}, "current_query": {"type": ["string", "null"]}}},
    "results": {"type": "array", "items": {"type": "object", "required": ["query_id", "scene", "query_accumulation_frames", "keyframe", "reference_level", "classification"], "properties": {"query_id": {"type": "string"}, "scene": {"enum": ["ENTRY", "MIDDLE", "EXIT", "HEADLAND", "OTHER"]}, "query_accumulation_frames": {"enum": [1, 3, 5]}, "keyframe": {"type": "integer", "minimum": 0}, "reference_level": {"enum": ["SAME_SESSION_REFERENCE", "INDEPENDENT_GROUND_TRUTH", "UNKNOWN"]}, "classification": {"enum": ["CORRECT", "FALSE_ACCEPT", "REJECTED", "TIMEOUT", "NO_DATA", "REFERENCE_UNKNOWN", "NOT_RUN"]}, "evidence_ref": {"type": ["object", "null"]}}}},
    "content_sha256": {"$ref": "agt_relocalization_query_set_v1.schema.json#/$defs/digest"}
  },
  "additionalProperties": true
}
