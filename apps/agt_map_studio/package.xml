<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema" ?>
<package format="3">
  <name>agt_map_studio</name>
  <version>0.3.0</version>
  <description>Offline PCD point-cloud viewer for AGT map packages.</description>
  <maintainer email="xuanyang.robotics@gmail.com">AGT Mapping Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>ament_index_cpp</depend>
  <depend>agt_pcd2grid_exporter</depend>
  <depend>eigen3_cmake_module</depend>

  <build_depend>qtbase5-dev</build_depend>
  <exec_depend>qtbase5-dev</exec_depend>
  <build_depend>libpcl-dev</build_depend>
  <exec_depend>libpcl-dev</exec_depend>
  <build_depend>libeigen3-dev</build_depend>
  <exec_depend>libeigen3-dev</exec_depend>
  <build_depend>libgl-dev</build_depend>
  <exec_depend>libgl-dev</exec_depend>
  <build_depend>libyaml-cpp-dev</build_depend>
  <exec_depend>libyaml-cpp-dev</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
