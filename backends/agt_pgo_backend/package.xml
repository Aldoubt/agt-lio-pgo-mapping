<?xml version="1.0"?>
<package format="3">
  <name>agt_pgo_backend</name>
  <version>0.1.0</version>
  <description>External PGO integration bridge for the AGT mapping backend contract.</description>
  <maintainer email="xuanyang.robotics@gmail.com">AGT Mapping Team</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>agt_mapping_backend_api</depend>
  <depend>interface</depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <exec_depend>pgo</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
