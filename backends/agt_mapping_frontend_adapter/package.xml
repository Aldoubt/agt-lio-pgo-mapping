<?xml version="1.0"?>
<package format="3">
  <name>agt_mapping_frontend_adapter</name>
  <version>0.1.0</version>
  <description>Backend-neutral LIO output normalization and frontend diagnostics.</description>
  <maintainer email="xuanyang.robotics@gmail.com">AGT Mapping Team</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_sensor_msgs</depend>
  <depend>message_filters</depend>
  <depend>livox_ros_driver2</depend>
  <depend>agt_mapping_frontend_api</depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
