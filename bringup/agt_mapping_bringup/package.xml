<?xml version="1.0"?>
<package format="3">
  <name>agt_mapping_bringup</name>
  <version>0.3.0</version>
  <description>Composition launch boundary for AGT mapping framework pipelines.</description>
  <maintainer email="xuanyang.robotics@gmail.com">AGT Mapping Team</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>agt_mapping_core</exec_depend>
  <exec_depend>agt_mid360_adapter</exec_depend>
  <exec_depend>agt_mapping_artifacts</exec_depend>
  <exec_depend>agt_mapping_exporter</exec_depend>
  <exec_depend>agt_pcd2grid_exporter</exec_depend>
  <exec_depend>agt_map_studio</exec_depend>
  <exec_depend>agt_fastlio_backend</exec_depend>
  <exec_depend>agt_pgo_backend</exec_depend>
  <exec_depend>fastlio2</exec_depend>
  <exec_depend>pgo</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>rviz_default_plugins</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <!-- Live MID360 mode (mapping_live_mid360.launch.py); replay never loads the driver. -->
  <exec_depend>livox_ros_driver2</exec_depend>
  <exec_depend>agt_robot_bringup</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>rosbag2_transport</exec_depend>
  <exec_depend>rosbag2_interfaces</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
